# UI audit (CTest): every menu command runs, and every window it opens has a
# name for each control and keyboard access (app/src/selftest/UiAudit.h).
#   cmake -DAPP=... -DCLI=... -DWORKDIR=... -P ui_audit.cmake
file(REMOVE_RECURSE "${WORKDIR}")
file(MAKE_DIRECTORY "${WORKDIR}")
set(ENV{ACESTUDIO_DATA_DIR} "${WORKDIR}/data")
set(ENV{QT_QPA_PLATFORM} "offscreen")
# 400 px, above Animate Sprite's preview size (its reduced-copy path), and
# 24 one-frame tags, like a character pack (one tag per action and direction):
# a long tag list once widened the window past the screen.
file(WRITE "${WORKDIR}/make.lua" "local d = ace.new_document(400, 400, 24)\nfor f = 0, 23 do d:set_cel(0, f, ace.image(400, 400, '#ff8800')) end\nd:add_tag('walk', 0, 2)\nfor f = 3, 23 do d:add_tag('attack_southwest_' .. f, f, f) end\nd:save('audit.acestudio')\n")
execute_process(COMMAND "${CLI}" run "${WORKDIR}/make.lua" --base "${WORKDIR}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "could not make the audit project")
endif()
execute_process(COMMAND "${APP}" --ui-audit "${WORKDIR}/report.json" "${WORKDIR}/audit.acestudio"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 900)
if(NOT rc EQUAL 0)
    string(REGEX MATCHALL "ui-audit: [^\n]*" steps "${err}")
    list(LENGTH steps n)
    if(n GREATER 0)
        math(EXPR last "${n} - 1")
        list(GET steps ${last} where)
    endif()
    message(FATAL_ERROR "the UI audit ended with ${rc} (last command: ${where})\n${err}")
endif()
file(READ "${WORKDIR}/report.json" report)
string(JSON actions LENGTH "${report}" actions)
string(JSON windows LENGTH "${report}" windows)
string(JSON unnamed LENGTH "${report}" unnamed)
string(JSON unreachable LENGTH "${report}" unreachable)
string(JSON controls GET "${report}" controls)
message(STATUS "UI audit: ${actions} commands, ${windows} windows, ${controls} controls, ${unnamed} unnamed, ${unreachable} not reachable by keyboard")
string(JSON modified GET "${report}" autosave modifiedDocuments)
string(JSON written GET "${report}" autosave recoveryFilesWritten)
string(JSON pending GET "${report}" autosave stillNeedingAutosave)
string(JSON left GET "${report}" autosave recoveryFilesAfterDiscard)
string(JSON tickMs GET "${report}" autosave tickMs)
message(STATUS "Autosave: ${modified} modified document(s), ${written} recovery file(s) written in the background (tick ${tickMs} ms), ${left} left after discarding")
if(modified LESS 1 OR written LESS modified OR NOT pending EQUAL 0 OR NOT left EQUAL 0)
    message(FATAL_ERROR "background autosave did not behave: ${report}")
endif()
string(JSON minWidth GET "${report}" minimumWidth)
string(JSON widest GET "${report}" widestWorkspace)
message(STATUS "Main window minimum width (widest of the editor with the project open and every workspace, ${widest}): ${minWidth} px")
if(minWidth GREATER 1280)
    message(FATAL_ERROR "the main window cannot fit a 1280 px screen (minimum width ${minWidth} px)")
endif()
if(actions LESS 100)
    message(FATAL_ERROR "the audit ran only ${actions} commands")
endif()
if(unnamed GREATER 0 OR unreachable GREATER 0)
    string(JSON list GET "${report}" unnamed)
    string(JSON list2 GET "${report}" unreachable)
    message(FATAL_ERROR "controls without an accessible name: ${list}\nnot reachable by keyboard: ${list2}")
endif()
